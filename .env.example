# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication
JWT_SECRET=eduintelli_super_secret_jwt_key_hackathon_2025
JWT_EXPIRES_IN=7d

# Database Configuration (Optional: SQLite used by default if POSTGRES_URL not provided)
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/eduintelli_db
DB_TYPE=sqlite
SQLITE_DB_PATH=./database/eduintelli.db

# AI & LLM Engine (Optional: Deterministic heuristic engine is used automatically if not provided)
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash
AI_ENGINE_MODE=hybrid
